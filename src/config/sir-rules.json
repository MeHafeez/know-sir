  "wizardFlow": {
    "startQuestion": "q1",
    "questions": [
      {
        "id": "q1",
        "textKey": "wizard.q1.text",
        "icon": "UserCheck",
        "options": [
          { "id": "q1_yes", "labelKey": "wizard.q1.yes", "icon": "CheckCircle", "color": "green", "next": "q2" },
          { "id": "q1_no", "labelKey": "wizard.q1.no", "icon": "XCircle", "color": "blue", "next": "q3" }
        ]
      },
      {
        "id": "q2",
        "textKey": "wizard.q2.text",
        "icon": "Search",
        "options": [
          { "id": "q2_found", "labelKey": "wizard.q2.found", "icon": "CheckCircle", "color": "green", "next": "q4" },
          { "id": "q2_notfound", "labelKey": "wizard.q2.notFound", "icon": "AlertCircle", "color": "orange", "next": "q5" }
        ]
      },
      {
        "id": "q3",
        "textKey": "wizard.q3.text",
        "icon": "User",
        "options": [
          { "id": "q3_indian", "labelKey": "wizard.q3.indian", "icon": "Flag", "color": "green", "next": "q6" },
          { "id": "q3_nri", "labelKey": "wizard.q3.nri", "icon": "Plane", "color": "blue", "next": "result_nri" }
        ]
      },
      {
        "id": "q4",
        "textKey": "wizard.q4.text",
        "icon": "MapPin",
        "options": [
          { "id": "q4_same", "labelKey": "wizard.q4.same", "icon": "Home", "color": "green", "next": "result_existing_ok" },
          { "id": "q4_moved_same", "labelKey": "wizard.q4.movedSame", "icon": "ArrowRight", "color": "orange", "next": "result_form8_transpose" },
          { "id": "q4_moved_diff", "labelKey": "wizard.q4.movedDiff", "icon": "Map", "color": "red", "next": "result_form6_new" }
        ]
      },
      {
        "id": "q5",
        "textKey": "wizard.q5.text",
        "icon": "AlertCircle",
        "options": [
          { "id": "q5_details_wrong", "labelKey": "wizard.q5.detailsWrong", "icon": "Edit", "color": "orange", "next": "result_form8_correction" },
          { "id": "q5_not_enrolled", "labelKey": "wizard.q5.notEnrolled", "icon": "UserPlus", "color": "blue", "next": "q6" }
        ]
      },
      {
        "id": "q6",
        "textKey": "wizard.q6.text",
        "icon": "Globe",
        "options": [
          { "id": "q6_resident", "labelKey": "wizard.q6.resident", "icon": "Home", "color": "green", "next": "result_form6_new" },
          { "id": "q6_nri", "labelKey": "wizard.q6.nri", "icon": "Plane", "color": "blue", "next": "result_nri" }
        ]
      }
    ],
    "results": [
      {
        "id": "result_existing_ok",
        "type": "success",
        "titleKey": "wizard.result.existingOk.title",
        "summaryKey": "wizard.result.existingOk.summary",
        "icon": "CheckCircle",
        "color": "green",
        "actions": [
          { "label": "Verify your details online", "url": "https://electoralsearch.eci.gov.in", "primary": true },
          { "label": "Download e-EPIC", "url": "https://voters.eci.gov.in/", "primary": false }
        ],
        "forms": [],
        "documentGroups": [],
        "helpline": "1950"
      },
      {
        "id": "result_form8_transpose",
        "type": "action",
        "titleKey": "wizard.result.form8Transpose.title",
        "summaryKey": "wizard.result.form8Transpose.summary",
        "icon": "ArrowRight",
        "color": "orange",
        "actions": [
          { "label": "Fill Form 8 Online", "url": "https://voters.eci.gov.in/", "primary": true },
          { "label": "Contact your BLO", "url": "https://voters.eci.gov.in/", "primary": false }
        ],
        "forms": ["form8"],
        "documentGroups": ["identity", "address", "photo"],
        "helpline": "1950"
      },
      {
        "id": "result_form6_new",
        "type": "action",
        "titleKey": "wizard.result.form6New.title",
        "summaryKey": "wizard.result.form6New.summary",
        "icon": "UserPlus",
        "color": "blue",
        "actions": [
          { "label": "Register Online — Form 6", "url": "https://voters.eci.gov.in/", "primary": true },
          { "label": "Contact your BLO", "url": "https://voters.eci.gov.in/", "primary": false }
        ],
        "forms": ["form6"],
        "documentGroups": ["identity", "address", "age", "photo"],
        "helpline": "1950"
      },
      {
        "id": "result_form8_correction",
        "type": "action",
        "titleKey": "wizard.result.form8Correction.title",
        "summaryKey": "wizard.result.form8Correction.summary",
        "icon": "Edit",
        "color": "purple",
        "actions": [
          { "label": "Fill Form 8 Online", "url": "https://voters.eci.gov.in/", "primary": true },
          { "label": "Visit local ERO office", "url": "https://www.eci.gov.in", "primary": false }
        ],
        "forms": ["form8"],
        "documentGroups": ["identity", "address", "photo"],
        "helpline": "1950"
      },
      {
        "id": "result_nri",
        "type": "action",
        "titleKey": "wizard.result.nri.title",
        "summaryKey": "wizard.result.nri.summary",
        "icon": "Globe",
        "color": "teal",
        "actions": [
          { "label": "Register as Overseas Voter — Form 6A", "url": "https://voters.eci.gov.in/", "primary": true },
          { "label": "NRI Voter Guide on ECI", "url": "https://www.eci.gov.in", "primary": false }
        ],
        "forms": ["form6a"],
        "documentGroups": ["identity", "photo"],
        "helpline": "1950"
      }
    ]
  },

  "decisionTree": {
    "root": {
      "id": "start",
      "question": "Are you already registered as a voter?",
      "icon": "User",
      "yes": {
        "id": "registered_check",
        "question": "Is your name found in the voter list?",
        "icon": "Search",
        "checkUrl": "https://electoralsearch.eci.gov.in",
        "yes": {
          "id": "address_check",
          "question": "Are you living at the same address?",
          "icon": "Home",
          "yes": {
            "id": "outcome_allgood",
            "outcome": true,
            "type": "success",
            "result": "result_existing_ok"
          },
          "no": {
            "id": "moved_type",
            "question": "Did you move within the same constituency?",
            "icon": "Map",
            "yes": { "id": "outcome_form8_t", "outcome": true, "type": "action", "result": "result_form8_transpose" },
            "no": { "id": "outcome_form6", "outcome": true, "type": "action", "result": "result_form6_new" }
          }
        },
        "no": {
          "id": "details_check",
          "question": "Are your details (name, DOB) correct in the old record?",
          "icon": "Edit",
          "yes": { "id": "outcome_form6_re", "outcome": true, "type": "action", "result": "result_form6_new" },
          "no": { "id": "outcome_form8_c", "outcome": true, "type": "action", "result": "result_form8_correction" }
        }
      },
      "no": {
        "id": "citizenship_check",
        "question": "Are you an Indian citizen living in India?",
        "icon": "Flag",
        "yes": { "id": "outcome_form6_new", "outcome": true, "type": "action", "result": "result_form6_new" },
        "no": { "id": "outcome_nri", "outcome": true, "type": "action", "result": "result_nri" }
      }
    }
  },

  "processTimeline": [
    {
      "id": "tl1",
      "phase": "Announcement",
      "icon": "Megaphone",
      "color": "blue",
      "description": "ECI announces the SIR schedule for a state/UT",
      "citizenAction": "Watch for official announcements in your state",
      "source": "https://www.eci.gov.in"
    },
